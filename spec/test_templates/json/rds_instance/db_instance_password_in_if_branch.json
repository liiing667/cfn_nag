{
  "Conditions": {
    "UseSnapshot": {
      "Fn::Equals": [
        {
          "Ref": "RestoreFromSnapshot"
        },
        "true"
      ]
    }
  },
  "Parameters": {
    "RestoreFromSnapshot": {
      "Type": "String",
      "Default": "false"
    }
  },
  "Resources": {
    "DbInstance": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceClass": "db.t3.micro",
        "Engine": "mysql",
        "AllocatedStorage": 20,
        "MasterUsername": "admin",
        "MasterUserPassword": {
          "Fn::If": [
            "UseSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            "plaintextPassword123"
          ]
        }
      }
    }
  }
}
